{{#each erros}}
    <div class="alert alert-danger">
        {{texto}}
    </div>
{{else}}
{{/each}}

<h3>Editar Categoria</h3>
<div class="card">
    <div class="card-body">
        <form action="/admin/categorias/edit" method="POST">

            <input
                type= "hidden"
                name= "_id"
                id= "_id"
                value="{{categoria._id}}"
            >

            <input
                type= "text"
                name= "nome"
                id= "nome"
                placeholder="Nome da Categoria"
                class="form-control"
                value="{{categoria.nome}}"
            >
            <br>
            <input
                type= "text"
                name= "slug"
                id= "slug"
                placeholder="Slug da Categoria"
                class="form-control"
                value="{{categoria.slug}}"
            >
            <br>
            <button type="submit" class="btn btn-success">Salvar Categoria</button>
        </form>
    </div>
</div>