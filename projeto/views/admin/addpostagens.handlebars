{{#each erros}}
    <div class="alert alert-danger">
        {{texto}}
    </div>
{{else}}
{{/each}}

<h3>Nova Postagem</h3>
<div class="card">
    <div class="card-body">
        <form action="/admin/postagens/nova" method="POST">
            <input
                type= "text"
                name= "titulo"
                id= "titulo"
                placeholder="Título da Postagem"
                class="form-control"
            >
            <br>
            <input
                type= "text"
                name= "slug"
                id= "slug"
                placeholder="Slug da Postagem"
                class="form-control"
            >
            <br>
            <input
                type= "text"
                name= "descricao"
                id= "descricao"
                placeholder="Descrição da Postagem"
                class="form-control"
            >
            <br>
            <textarea
                name= "conteudo"
                id= "conteudo"
                placeholder="Conteúdo da Postagem"
                class="form-control"
            ></textarea>
            <select 
                name="categoria" 
                id="categoria" 
                class="form-control">
                <option value="">Selecione uma categoria</option>
                    {{#each categorias}}
                        <option value="{{this._id}}">{{this.nome}}</option>
                    {{else}}
                        <option value="0">Nenhuma categoria cadastrada</option>
                    {{/each}}
            </select>
            <br>
            <button type="submit" class="btn btn-success mt-4">Criar Postagem</button>
        </form>
    </div>
</div>