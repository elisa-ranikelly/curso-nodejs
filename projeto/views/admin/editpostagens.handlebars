{{#each erros}}
    <div class="alert alert-danger">
        {{texto}}
    </div>
{{else}}
{{/each}}

<h3>Editar Postagem</h3>
<div class="card">
    <div class="card-body">
        <form action="/admin/postagens/edit" method="POST">
            <input
                type="hidden"
                value="{{postagem._id}}"
                name="_id"
                id="_id"
            >
            <input
                type= "text"
                name= "titulo"
                id= "titulo"
                placeholder="Título da Postagem"
                class="form-control"
                value="{{postagem.titulo}}"
            >
            <br>
            <input
                type= "text"
                name= "slug"
                id= "slug"
                placeholder="Slug da Postagem"
                class="form-control"
                value="{{postagem.slug}}"
            >
            <br>
            <input
                type= "text"
                name= "descricao"
                id= "descricao"
                placeholder="Descrição da Postagem"
                class="form-control"
                value= "{{postagem.descricao}}"
            >
            <br>
            <textarea
                name= "conteudo"
                id= "conteudo"
                placeholder="Conteúdo da Postagem"
                class="form-control"
                {{postagem.conteudo}}
            ></textarea>
            <br>
            <select 
                name="categoria" 
                id="categoria" 
                class="form-control">
                <option value="">Selecione uma categoria</option>
                    {{#each categorias}}
                        <option value="{{this._id}}">{{this.nome}}</option>
                    {{else}}
                        <option value="0">Nenhuma postagem cadastrada</option>
                    {{/each}}
            </select>
            <br>
            <button type="submit" class="btn btn-success">Salvar Postagem</button>
        </form>
    </div>
</div>