<h2>Lista de Postagens</h2>
<hr>
<a href="/admin/postagens/add" class="btn btn-primary">Adicionar Postagem</a>

{{#each postagens}}
    <div class="card mt-4">
        <div class="card-body">
            <h4>{{titulo}}</h4>
            <small>{{slug}}</small>
            <p>{{descricao}}</p>
            <small>{{date}}</small><br>
            <small>{{categoria.nome}}</small>
            <a href="/admin/postagens/edit/{{_id}}" class="btn btn-primary mt-4">Editar</a>

            <form action="/admin/postagens/deletar" method="POST">
                <input
                    type="hidden"
                    name="id"
                    value="{{_id}}"
                >
                <button type="submit" class="btn btn-danger mt-2">Deletar postagem</button>
            </form>
        </div>
    </div>
{{else}}
    <div class="alert alert-danger mt-4">
        Nenhuma postagem cadastrada.
    </div>
{{/each}}