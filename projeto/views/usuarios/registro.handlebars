<h1>Realize seu cadastro</h1>

{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{else}}

{{/each}}
<div class="card">
    <div class="card-body">
        <form action="" method="POST">
            <input 
                type="text"
                name="nome"
                placeholder="Digite seu nome"
                class="form-control"
                required
            >
            <br>
            <input 
                type="email"
                name="email"
                placeholder="Digite seu email"
                class="form-control"
                required
            >
             <br>
            <input 
                type="password"
                name="senha"
                placeholder="Digite sua senha"
                class="form-control"
                required
            >
             <br>
            <input 
                type="password"
                name="senha2"
                placeholder="Confirme sua senha"
                class="form-control"
                required
            >
             <br>
            <button type="submit" class="btn btn-success">Cadastrar conta</button>
        </form>
    </div>
</div>