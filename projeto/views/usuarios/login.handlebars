<h1>Entrar na conta</h1>
<div class="card">
    <div class="card-body">
        <form action="/usuarios/login" method="POST">
            <input 
                type="email"
                name="email"
                placeholder="Digite seu email"
                class="form-control"
                required
            >
             <br>
            <input 
                type="password"
                name="senha"
                placeholder="Digite sua senha"
                class="form-control"
                required
            >
             <br>
            <button type="submit" class="btn btn-success">Entrar<button>
        </form>
    </div>
</div>